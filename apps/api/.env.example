# Postgres
DATABASE_URL="postgresql://siasa:siasa@localhost:5432/siasa_iot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MQTT
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# MQTT LoRaWAN (gateway ChirpStack, sensores de calidad de aire)
LORAWAN_MQTT_URL="mqtt://localhost:1883"
LORAWAN_MQTT_USERNAME=""
LORAWAN_MQTT_PASSWORD=""

# Carpeta donde se guardan las fotos de area subidas desde la app (relativa al cwd del proceso)
AREA_UPLOADS_DIR="uploads/areas"

# JWT (genera secretos propios, no reuses estos ejemplos)
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-aleatorio-largo"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puerto separado para consumo externo (integraciones): solo acepta x-api-key,
# bloquea /auth /users /api-keys. Comenta esta linea para desactivarlo.
EXTERNAL_API_PORT=8081

# Seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"

# Puente BACnet/IP (apps/bacnet-bridge): corre nativo en el host, NO en Docker, porque Docker
# Desktop en Windows no puede enrutar UDP/47808 hacia la LAN real. host.docker.internal apunta
# al host desde dentro del contenedor. Genera un token propio y usa el mismo en ambos lados.
BACNET_BRIDGE_URL="http://host.docker.internal:3099"
BACNET_BRIDGE_TOKEN="cambia-esto-por-un-token-aleatorio"
