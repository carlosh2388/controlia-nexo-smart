generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
  /// Rol de las API keys que usa un Agente_Go: solo puede llamar POST /devices/agent-sync, nada mas.
  agent
}

enum DeviceProtocol {
  mqtt
  http
  ewelink
  lorawan
  bacnet
  /// Medidores/generadores leidos por un Agente_Go via Modbus TCP (ej. EBO AS-P de una sede IGSS). Solo lectura.
  modbus
}

enum DeviceKind {
  switch
  sensor
  climate
}

enum CommandAction {
  on
  off
}

enum CommandStatus {
  pending
  sent
  acked
  failed
}

enum ComparisonOperator {
  eq
  ne
}

enum RuleTriggerType {
  device_state
  schedule
}

enum RuleExecutionStatus {
  success
  failed
  condition_not_met
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(viewer)
  /// Mantenimiento de usuarios (Centro de mando): datos de contacto, sedes que puede ver (vacio =
  /// todas), pestaña con la que abre la app, y si esta activo (inactivo = no puede iniciar sesion).
  fullName            String?
  email               String?
  sites               String[]  @default([])
  homeTab             String    @default("centro")
  active              Boolean   @default(true)
  receivesAlarmEmails Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  commands        Command[]
  eventLogs       EventLog[]
  automationRules AutomationRule[]
  apiKeys         ApiKey[]

  @@map("users")
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  keyHash     String    @unique
  role        Role      @default(viewer)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  replacedByTokenHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id            String         @id @default(uuid())
  name          String
  protocol      DeviceProtocol @default(mqtt)
  kind          DeviceKind     @default(switch)
  commandTopic  String?
  stateTopic    String?
  payloadOn     String         @default("ON")
  payloadOff    String         @default("OFF")
  httpBaseUrl   String?
  metadata      Json?
  areaId        String?
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  state    DeviceState?
  commands Command[]
  readings DeviceReading[]
  events   SiteEvent[]
  gaps     ReadingGap[]

  ruleTriggers   RuleTrigger[]
  ruleConditions RuleCondition[]
  ruleActions    RuleAction[]

  @@index([areaId])
  @@map("devices")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  building  String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas Area[]

  @@map("tenants")
}

/// Zona fisica del piso de un tenant (ej. "CCT", "Sala Presidencial"), con su render/foto e
/// hitbox (left/top/width/height en % sobre la imagen general) para la Vista de Edificio.
model Area {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  imageFile String
  boxLeft   Float?
  boxTop    Float?
  boxWidth  Float?
  boxHeight Float?
  /// Contorno real del area sobre imageFile: arreglo [[x,y], ...] en pixeles nativos de la imagen (no porcentaje).
  points    Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@unique([tenantId, slug])
  @@map("areas")
}

/// Historico de lecturas de sensores (para graficas de tendencias). Solo se registran
/// dispositivos kind=sensor - climatizacion/switches no necesitan historial por ahora.
model DeviceReading {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings   Json
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
  @@map("device_readings")
}

/// Calidad de cada lectura del historial (piloto Gravix): real = leida en vivo, recuperada = traida
/// de la memoria del medidor, estimada = calculada (ej. energia de un hueco por diferencia de contador).
enum ReadingQuality {
  real
  recuperada
  estimada
}

/// Historial detallado de equipos de energia (Fase A del piloto Gravix): una fila por variable y
/// lectura. Es una hypertable de TimescaleDB particionada por "time" (ver la migracion
/// add_timeseries_readings): se comprime sola despues de 7 dias. Sin relacion a Device a proposito:
/// una FK en una tabla de millones de filas haria muy caro borrar un dispositivo.
/// La llave (deviceId, metric, time) hace idempotente cualquier reenvio.
model Reading {
  time     DateTime       @db.Timestamptz(3)
  deviceId String
  metric   String
  value    Float
  quality  ReadingQuality @default(real)

  @@id([deviceId, metric, time])
  @@map("readings")
}

enum GapStatus {
  open
  closed
  recovered
  partial
  estimated
  unrecoverable
}

/// Periodo en que un equipo no entrego lecturas nuevas (detectado por GapDetectorService). "endedAt"
/// queda null mientras el hueco sigue abierto.
model ReadingGap {
  id        String    @id @default(uuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  cause     String
  status    GapStatus @default(open)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deviceId, startedAt])
  @@index([status])
  @@map("reading_gaps")
}

enum EventSeverity {
  info
  warning
  critical
}

/// Evento detectado en tiempo real por el Agente_Go de una sede (transferencia del ATS, arranque de
/// generador, alarma por umbral, puerta abierta, equipo sin comunicacion...). Es el historial que
/// muestra la pestaña Sedes > Eventos. agentEventId lo genera el agente y hace idempotente el reenvio
/// (el agente guarda los eventos en disco y los reintenta si la API no respondio).
model SiteEvent {
  id           String        @id @default(uuid())
  agentEventId String        @unique
  buildingKey  String
  deviceId     String?
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  externalId   String?
  type         String
  severity     EventSeverity @default(info)
  message      String
  value        Float?
  data         Json?
  occurredAt   DateTime
  receivedAt   DateTime      @default(now())

  @@index([buildingKey, occurredAt])
  @@index([deviceId, occurredAt])
  @@map("site_events")
}

/// Configuracion remota de un Agente_Go: que protocolos escucha, en que IP y puertos. Se edita desde
/// la web (Agente Go > Configuracion) y el agente la descarga y la aplica sin reiniciar; su config.yaml
/// local solo necesita buildingKey + credenciales de la API. Cada guardado sube version; el agente
/// reporta appliedVersion cuando la termino de aplicar. scanRequest/scanResult son el pedido de
/// descubrimiento en la red de la sede y su resultado (ver docs/agentes-go-manual.md).
model AgentConfig {
  buildingKey    String    @id
  version        Int       @default(1)
  /// Mismas secciones que config.yaml (mqtt, lorawan, bacnet, modbusServers, loraGateway) + discovery.
  config         Json
  appliedVersion Int?
  appliedAt      DateTime?
  applyError     String?
  scanRequest    Json?
  scanResult     Json?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("agent_configs")
}

model DeviceState {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state     String
  readings  Json?
  rawPayload String?
  updatedAt DateTime @updatedAt

  @@map("device_states")
}

model Command {
  id            String        @id @default(uuid())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action        CommandAction
  status        CommandStatus @default(pending)
  requestedBy   String?
  user          User?         @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   AutomationRule? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  error         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([deviceId])
  @@map("commands")
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  triggers   RuleTrigger[]
  conditions RuleCondition[]
  actions    RuleAction[]
  executions RuleExecution[]
  commands   Command[]

  @@map("automation_rules")
}

/// Cuando el estado del dispositivo referenciado cumple operator+value, la regla se evalua.
model RuleTrigger {
  id       String             @id @default(uuid())
  ruleId   String
  rule     AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type     RuleTriggerType    @default(device_state)
  deviceId String?
  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operator ComparisonOperator @default(eq)
  value    String?
  /// Solo para type=schedule: hora local del servidor en formato "HH:mm" (24h).
  scheduleTime String?
  /// Solo para type=schedule: dias de la semana (0=domingo..6=sabado); vacio = todos los dias.
  scheduleDays Int[]          @default([])

  @@index([ruleId])
  @@index([deviceId])
  @@map("rule_triggers")
}

/// Condicion adicional (AND) sobre el estado actual de otro dispositivo, evaluada antes de ejecutar las acciones.
model RuleCondition {
  id       String             @id @default(uuid())
  ruleId   String
  rule     AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operator ComparisonOperator @default(eq)
  value    String

  @@index([ruleId])
  @@index([deviceId])
  @@map("rule_conditions")
}

/// Comando a despachar cuando la regla dispara; se ejecutan en orden, con retardo opcional.
model RuleAction {
  id       String        @id @default(uuid())
  ruleId   String
  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  order    Int           @default(0)
  deviceId String
  device   Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action   CommandAction
  delayMs  Int           @default(0)

  @@index([ruleId])
  @@map("rule_actions")
}

model RuleExecution {
  id        String               @id @default(uuid())
  ruleId    String
  rule      AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status    RuleExecutionStatus
  message   String?
  createdAt DateTime             @default(now())

  @@index([ruleId])
  @@map("rule_executions")
}

model EventLog {
  id        String   @id @default(uuid())
  type      String
  deviceId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([type])
  @@map("event_logs")
}

/// Permisos de cada perfil (rol) en el menu: pestañas que ve y acciones que puede hacer. El admin
/// siempre tiene todo (no se guarda). Lo edita el administrador en "Usuarios y permisos".
model RolePermission {
  role      Role     @id
  tabs      String[]
  actions   String[]
  updatedAt DateTime @updatedAt

  @@map("role_permissions")
}

/// Centro de mando: foto de cada medidor de las sedes que se leen por el EBO (api-SIASA), tomada
/// del monitoreo central cada minuto. Da historial y tendencias a esas sedes. Hypertable.
model CentroLectura {
  time      DateTime @db.Timestamptz(3)
  sede      String
  medidor   String
  kw        Float?
  vProm     Float?
  aProm     Float?
  estado    String

  @@id([sede, medidor, time])
  @@map("centro_lecturas")
}

/// Alarmas del Gravix de sede (motor de apps/api/src/alarmas): mismas columnas y reglas que api_eventos
/// de api-SIASA (monitoreo/eventos_modbus.js), para que el Centro de mando las lea igual.
model AlarmaEvento {
  id                 String    @id @default(uuid())
  codigo             String    @unique
  sede               String
  evento             String
  severidad          String
  dispositivo        String?
  inventario         String?
  inicio             DateTime  @db.Timestamptz(3)
  fin                DateTime? @db.Timestamptz(3)
  duracionS          Int?
  detalle            Json?
  notificadoEn       DateTime? @db.Timestamptz(3)
  cierreNotificadoEn DateTime? @db.Timestamptz(3)
  intentosCorreo     Int       @default(0)
  creadoEn           DateTime  @default(now()) @db.Timestamptz(3)

  @@index([inicio(sort: Desc)])
  @@index([fin])
  @@map("alarma_eventos")
}

/// Correos de alarma que preparo el Gravix de sede: enviados, o solo preparados (modo paralelo,
/// mientras los envia api-SIASA) para compararlos.
model AlarmaCorreo {
  id       String   @id @default(uuid())
  tipo     String
  asunto   String
  codigos  String[] @default([])
  para     String?
  enviado  Boolean  @default(false)
  motivo   String?
  texto    String?
  html     String?
  creadoEn DateTime @default(now()) @db.Timestamptz(3)

  @@index([creadoEn(sort: Desc)])
  @@map("alarma_correos")
}

/// Grupos del arbol del centro de mando (fases del proyecto: Telemetria 1, 2, 3...). Editables.
model RedGrupo {
  id        String    @id
  nombre    String
  color     String
  orden     Int       @default(0)
  sedes     RedSede[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("red_grupos")
}

/// Sedes de la red en Nodivo. origen "central": una de las sedes que ya lee el monitoreo central
/// (solo se guarda su grupo); origen "nodivo": sede nueva leida por sus Agentes Go (buildingKeys);
/// origen "gravix": sede con su propio Gravix (VM local), el centro la consulta en `url`.
model RedSede {
  id        String    @id
  nombre    String
  origen    String    @default("nodivo")
  grupoId   String?
  grupo     RedGrupo? @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  agentes   String[]  @default([])
  /// Solo origen "gravix": API de la sede, ej. http://10.20.5.10:3010
  url       String?
  /// Solo origen "gravix": clave de consulta (rol viewer) cifrada con AES-256-GCM.
  apiKeyEnc String?
  /// De donde lee el Centro de mando las alarmas y correos de la sede: "api-siasa" (la api-SIASA de la
  /// sede, la que envia los correos hoy) o "gravix" (el motor de alarmas del Gravix de sede).
  alarmasFuente String @default("api-siasa")
  lat       Float?
  lon       Float?
  plantilla String?
  orden     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([grupoId])
  @@map("red_sedes")
}