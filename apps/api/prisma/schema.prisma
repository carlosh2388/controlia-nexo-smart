generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
}

enum DeviceProtocol {
  mqtt
  http
  ewelink
  lorawan
  bacnet
}

enum DeviceKind {
  switch
  sensor
  climate
}

enum CommandAction {
  on
  off
}

enum CommandStatus {
  pending
  sent
  acked
  failed
}

enum ComparisonOperator {
  eq
  ne
}

enum RuleTriggerType {
  device_state
  schedule
}

enum RuleExecutionStatus {
  success
  failed
  condition_not_met
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(viewer)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens   RefreshToken[]
  commands        Command[]
  eventLogs       EventLog[]
  automationRules AutomationRule[]
  apiKeys         ApiKey[]

  @@map("users")
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  prefix      String
  keyHash     String    @unique
  role        Role      @default(viewer)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  replacedByTokenHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Device {
  id            String         @id @default(uuid())
  name          String
  protocol      DeviceProtocol @default(mqtt)
  kind          DeviceKind     @default(switch)
  commandTopic  String?
  stateTopic    String?
  payloadOn     String         @default("ON")
  payloadOff    String         @default("OFF")
  httpBaseUrl   String?
  metadata      Json?
  areaId        String?
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  state    DeviceState?
  commands Command[]
  readings DeviceReading[]

  ruleTriggers   RuleTrigger[]
  ruleConditions RuleCondition[]
  ruleActions    RuleAction[]

  @@index([areaId])
  @@map("devices")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  building  String
  level     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas Area[]

  @@map("tenants")
}

/// Zona fisica del piso de un tenant (ej. "CCT", "Sala Presidencial"), con su render/foto e
/// hitbox (left/top/width/height en % sobre la imagen general) para la Vista de Edificio.
model Area {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  imageFile String
  boxLeft   Float?
  boxTop    Float?
  boxWidth  Float?
  boxHeight Float?
  /// Contorno real del area sobre imageFile: arreglo [[x,y], ...] en pixeles nativos de la imagen (no porcentaje).
  points    Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices Device[]

  @@unique([tenantId, slug])
  @@map("areas")
}

/// Historico de lecturas de sensores (para graficas de tendencias). Solo se registran
/// dispositivos kind=sensor - climatizacion/switches no necesitan historial por ahora.
model DeviceReading {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  readings   Json
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
  @@map("device_readings")
}

model DeviceState {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  state     String
  readings  Json?
  rawPayload String?
  updatedAt DateTime @updatedAt

  @@map("device_states")
}

model Command {
  id            String        @id @default(uuid())
  deviceId      String
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action        CommandAction
  status        CommandStatus @default(pending)
  requestedBy   String?
  user          User?         @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  triggeredById String?
  triggeredBy   AutomationRule? @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  error         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([deviceId])
  @@map("commands")
}

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdBy   String?
  user        User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  triggers   RuleTrigger[]
  conditions RuleCondition[]
  actions    RuleAction[]
  executions RuleExecution[]
  commands   Command[]

  @@map("automation_rules")
}

/// Cuando el estado del dispositivo referenciado cumple operator+value, la regla se evalua.
model RuleTrigger {
  id       String             @id @default(uuid())
  ruleId   String
  rule     AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  type     RuleTriggerType    @default(device_state)
  deviceId String?
  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operator ComparisonOperator @default(eq)
  value    String?
  /// Solo para type=schedule: hora local del servidor en formato "HH:mm" (24h).
  scheduleTime String?
  /// Solo para type=schedule: dias de la semana (0=domingo..6=sabado); vacio = todos los dias.
  scheduleDays Int[]          @default([])

  @@index([ruleId])
  @@index([deviceId])
  @@map("rule_triggers")
}

/// Condicion adicional (AND) sobre el estado actual de otro dispositivo, evaluada antes de ejecutar las acciones.
model RuleCondition {
  id       String             @id @default(uuid())
  ruleId   String
  rule     AutomationRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operator ComparisonOperator @default(eq)
  value    String

  @@index([ruleId])
  @@index([deviceId])
  @@map("rule_conditions")
}

/// Comando a despachar cuando la regla dispara; se ejecutan en orden, con retardo opcional.
model RuleAction {
  id       String        @id @default(uuid())
  ruleId   String
  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  order    Int           @default(0)
  deviceId String
  device   Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  action   CommandAction
  delayMs  Int           @default(0)

  @@index([ruleId])
  @@map("rule_actions")
}

model RuleExecution {
  id        String               @id @default(uuid())
  ruleId    String
  rule      AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status    RuleExecutionStatus
  message   String?
  createdAt DateTime             @default(now())

  @@index([ruleId])
  @@map("rule_executions")
}

model EventLog {
  id        String   @id @default(uuid())
  type      String
  deviceId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([type])
  @@map("event_logs")
}
