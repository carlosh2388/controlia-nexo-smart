# Postgres
DATABASE_URL="postgresql://siasa:siasa@localhost:5432/siasa_iot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MQTT (Mosquitto local de desarrollo por defecto)
MQTT_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Puente BACnet/IP (apps/bacnet-bridge): corre nativo en el host, NO en Docker, porque Docker
# Desktop en Windows no puede enrutar UDP/47808 hacia la LAN real. Genera un token propio.
BACNET_BRIDGE_URL="http://host.docker.internal:3099"
BACNET_BRIDGE_TOKEN="cambia-esto-por-un-token-aleatorio"
